# Copy this file to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=3001

# Origins allowed to call this API (no trailing slash). In production this
# must match the deployed frontend's origin exactly, or the admin login
# cookie will be silently rejected by the browser.
FRONTEND_URL=http://localhost:5173
FRONTEND_PROD_URL=https://nexoryn-delta.vercel.app
ADMIN_URL=http://localhost:5174
ADMIN_PROD_URL=

# Database — PostgreSQL. Local dev can use the docker-compose.yml in this folder:
#   docker compose up -d
#   DATABASE_URL below matches its default credentials.
# Production uses Neon instead — see docs/DEPLOYMENT.md. Use Neon's POOLED
# connection string there (hostname contains "-pooler"), not the direct one.
DATABASE_URL=postgresql://nexoryn_user:nexoryn_password_dev@localhost:5432/nexoryn_dev

# JWT — sign admin session tokens. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_64+_char_secret
JWT_EXPIRES_IN=7d

# Email (Resend) — replaces the frontend's old client-side EmailJS integration.
# Sign up at https://resend.com, verify a sending domain, get an API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_ADDRESS=Nexoryn <noreply@nexoryn.ai>
ADMIN_NOTIFICATION_EMAIL=nexorynofficial@gmail.com

# Cloudinary (image uploads/CDN for project photos, screenshots, team photos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate limiting
CONTACT_RATE_LIMIT_WINDOW_MS=600000
CONTACT_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

LOG_LEVEL=info
