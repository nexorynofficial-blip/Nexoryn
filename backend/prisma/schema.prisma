// Nexoryn backend — Prisma schema.
// Adapted from the team's planning docs (01-BACKEND-SETUP-GUIDE.md), with two
// fixes applied to what was drafted there:
//   1. `Investment.creditor` is a second, differently-named relation to
//      AdminUser (the first being `admin`) — Prisma requires an explicit
//      inverse field for every named relation; the draft only declared the
//      unnamed side (`investmentTransactions`). Added `owedToMe` below.
//   2. `Project.photoId` is a required field but the draft paired it with
//      `onDelete: SetNull`, which is invalid on a non-nullable column
//      (Prisma rejects this at schema-validation time). Switched to
//      `onDelete: Restrict` — matches the app-level "can't delete an asset
//      still in use" check already in the assets route anyway.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (Windows/Mac/Linux, whatever generated it).
  // "rhel-openssl-3.0.x" is required for Vercel's Node.js Serverless
  // Functions, which run on Amazon Linux (OpenSSL 3.0) — without it Prisma
  // ships a query engine binary the deployed function can't execute.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ADMIN & AUTH
// ============================================================================

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  // Stable ledger identity, set once when the account is created and never
  // edited through the UI. `name` is a free-text display name the admin can
  // change; this is what the finance system matches on (one of PARTNERS in
  // src/services/validation.ts). Keeping them separate is what lets someone
  // rename themselves without silently detaching their Finance position.
  // Null for any non-partner admin account.
  partnerName  String?
  // "owner" — full access, including the finance ledger, the admin directory
  //           and the contact-submission export (customer PII).
  // "admin"  — content only: projects, services, reviews, team, FAQs, assets.
  // Enforced by requireRole() in src/middleware/auth.ts. New accounts start as
  // "admin" and must be promoted deliberately; the migration that introduced
  // this promoted every account that already existed to "owner", so nobody
  // lost access they had before it landed.
  role         String    @default("admin")
  profilePhoto String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  // Session revocation cut-off. Any token issued (`iat`) before this instant is
  // rejected by authMiddleware even though its signature and expiry are still
  // valid. Logging out and changing your password both push this forward,
  // which is what makes those actions kill sessions on other devices — a
  // stateless JWT otherwise stays usable until it expires.
  sessionsValidFrom DateTime @default(now())

  // ── Action passkey ───────────────────────────────────────────────────────
  // A second secret, separate from the login password, required to approve or
  // reject a finance request and to change the account password (see
  // verifyActionPasskey in src/services/passkey.ts). Generated once from
  // Account Settings and shown exactly one time — only its bcrypt hash is
  // stored, so it can never be displayed again, only regenerated (which
  // requires the account password, for when it has been forgotten).
  actionPasskeyHash  String?
  actionPasskeySetAt DateTime?

  uploadedAssets      Asset[]
  financeRecords      FinanceRecord[]
  createdProjects     Project[]
  internalProjects    InternalProject[]
  investments         Investment[]
  auditLogs           AuditLog[]

  @@index([email])
}

/// Append-only record of security- and money-relevant actions. Nothing in the
/// app ever updates or deletes a row here — that is the point: a ledger entry
/// can be removed, but the fact that someone removed it cannot be.
model AuditLog {
  id       String   @id @default(cuid())
  // Null when the actor could not be identified (a failed login names the
  // email that was tried in `metadata` instead).
  adminId  String?
  admin    AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  // Free-text actor label kept alongside adminId so the trail survives the
  // account being deleted.
  actor    String
  // e.g. "auth.login", "auth.login_failed", "auth.logout", "account.password_changed",
  // "finance.created", "finance.approved", "finance.rejected", "finance.deleted".
  action   String
  // What the action was performed on: "investment:<id>", "admin:<id>", …
  target   String?
  ip       String?
  metadata Json?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

/// Backing store for the login and contact-form rate limiters.
///
/// express-rate-limit's default store lives in the memory of one process. On
/// Vercel that means one *function instance*, so limits reset on every cold
/// start and an attacker spread across warm instances gets a multiple of the
/// intended allowance. Persisting the counters makes the limit hold across
/// every instance — which is the whole point of rate-limiting a login form.
model RateLimitHit {
  /// "<limiter>:<client key>" — e.g. "login:203.0.113.9".
  key       String   @id
  count     Int      @default(0)
  /// When the current window ends; a hit after this resets `count` to 1.
  expiresAt DateTime

  @@index([expiresAt])
}

// ============================================================================
// PUBLIC CONTENT MODELS
// ============================================================================

model Project {
  id    String @id @default(cuid())
  slug  String @unique
  title String

  // NOTE: `service` here historically used "Brand & Graphic Design" while
  // Review.service / ServiceCategory.serviceName use bare "Graphic Design" —
  // this inconsistency already exists in the live frontend data
  // (src/data/projects.js vs. src/data/reviews.js / services.js). Pick ONE
  // canonical string during the seed/migration step (see
  // scripts/extract-frontend-data.mjs) rather than perpetuating both.
  industry    String
  service     String
  description String
  tags        String[]

  photoId String
  photo   Asset  @relation("ProjectPhoto", fields: [photoId], references: [id], onDelete: Restrict)

  // Case study — kept as JSONB rather than fully normalized: its shape
  // genuinely varies (standard automation/web-dev shape vs. the design-project
  // shape with designProcess/keyFeatures/useCases/gallery instead of
  // overview.workflow/results/techStack), and nothing in the current admin
  // requirements needs to query *inside* it. See docs/DATA-MODEL.md §2.
  caseStudy Json

  isFeatured    Boolean @default(false)
  featuredOrder Int?

  createdBy String?
  creator   AdminUser? @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([industry])
  @@index([service])
  @@index([isFeatured])
}

model ServiceCategory {
  id            String @id @default(cuid())
  slug          String @unique // "automation" | "web-development" | "graphic-design"
  serviceName   String
  overviewIcon  String // lucide-react icon name
  gooeyId       String
  overview      Json // { heading: string, body: string }
  mobileSummary Json // { description, howWeWork[], whatYouGet[], platforms[] }

  subServices SubService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubService {
  id         String          @id @default(cuid())
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  slug        String // unique within its category, e.g. "workflow-automation"
  icon        String // lucide-react icon name
  name        String
  description String
  howWeWork   String[]
  whatYouGet  String[]
  platforms   String[]
  order       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model Review {
  id         String   @id @default(cuid()) // internal id; `displayId` keeps the original handle (e.g. "abu786110")
  displayId  String   @unique
  name       String
  location   String
  service    String // "Automation" | "Web Development" | "Graphic Design"
  text       String   @db.Text
  order      Int
  isFeatured Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([service])
  @@index([isFeatured])
}

model TeamMember {
  id      String  @id @default(cuid())
  name    String
  role    String
  photoId String?
  photo   Asset?  @relation("TeamMemberPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  order   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FAQ {
  id       String  @id @default(cuid())
  question String
  answer   String  @db.Text
  category String  @default("general")
  order    Int
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

// ============================================================================
// CONTACT FORMS
// ============================================================================

model ContactSubmission {
  id     String @id @default(cuid())
  formId String // "question" | "consultation" | "start"
  status String @default("new") // "new" | "read" | "handled"
  fields Json // shape depends on formId — see docs/DATA-MODEL.md §4

  emailedAt  DateTime?
  emailError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================================
// ASSETS / FILE UPLOADS
// ============================================================================

model Asset {
  id       String @id @default(cuid())
  url      String
  altText  String
  width    Int?
  height   Int?
  mimeType String
  fileSize Int

  uploadedBy String
  uploader   AdminUser @relation(fields: [uploadedBy], references: [id])
  uploadedAt DateTime  @default(now())

  projectPhotos Project[]    @relation("ProjectPhoto")
  teamPhotos    TeamMember[] @relation("TeamMemberPhoto")

  @@index([uploadedAt])
  @@index([uploadedBy])
}

// ============================================================================
// FINANCE & ADMIN TRACKING
// ============================================================================

model Investment {
  id          String    @id @default(cuid())
  adminId     String // which logged-in admin recorded this row (audit trail only)
  admin       AdminUser @relation(fields: [adminId], references: [id])
  amount      Decimal   @db.Decimal(12, 2)
  date        DateTime
  description String
  type        String // "invested" | "earned" | "personal_withdraw" | "debt_paid"

  // All three drawn from the fixed actor list (Waseem Farooq / Akbar Khan /
  // Abdul Ahad / Nexoryn) — see LEDGER_ACTORS in src/services/validation.ts.
  //   enteredBy — the logged-in admin who recorded the row. Set server-side
  //               from the session, never trusted from the request body.
  //   actionBy  — whose money actually moved.
  //   paidTo    — required for (and only used by) type "debt_paid": who is
  //               being repaid. A partner means a peer settlement of the
  //               investment imbalance; "Nexoryn" means repaying a personal
  //               withdrawal back to the company.
  enteredBy String
  actionBy  String
  paidTo    String?

  // Approval workflow. Only "approved" rows are counted by
  // services/financeCalculations.ts — "pending" and "rejected" are inert and
  // change no number anywhere.
  //
  // Every row except a `debt_paid` is created already "approved": logging your
  // own investment, revenue, or withdrawal needs no counterparty's consent.
  // A `debt_paid` claims someone ELSE's money moved, so it waits:
  //   paidTo = a partner  -> that partner decides.
  //   paidTo = "Nexoryn"  -> either other partner decides (never the partner
  //                          whose debt it clears, never whoever logged it).
  // See eligibleApprovers() in routes/admin/finance.ts.
  approvalStatus String    @default("approved") // "pending" | "approved" | "rejected"
  decidedBy      String? // actor who approved/rejected
  decidedAt      DateTime?
  decisionNote   String? // optional reason, mainly for a rejection

  // A correction proposed against an already-*approved* (counted) row —
  // separate from the approvalStatus workflow above, which governs whether a
  // freshly created row counts at all. This one governs whether a change to a
  // row that already counts gets applied. Only ever set on an approved row;
  // the row keeps counting with its current field values until this is
  // approved. Any partner other than whoever requested it can approve or
  // reject — see requestEditSchema / eligiblePendingChangeApprovers() in
  // routes/admin/finance.ts.
  pendingChangeType  String? // "edit_description" | "delete", or null for none pending
  pendingDescription String? // the proposed new description, when type is "edit_description"
  pendingRequestedBy String? // actor who proposed the change
  pendingRequestedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
  @@index([actionBy])
  @@index([paidTo])
  @@index([date])
  @@index([approvalStatus])
}

model FinanceRecord {
  id      String    @id @default(cuid())
  adminId String
  admin   AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  year  Int
  month Int // 1-12

  totalInvested Decimal @default(0) @db.Decimal(12, 2)
  totalEarned   Decimal @default(0) @db.Decimal(12, 2)
  totalExpense  Decimal @default(0) @db.Decimal(12, 2)

  profitPercentage Decimal @default(33.33) @db.Decimal(5, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, year, month])
  @@index([year, month])
}

// ============================================================================
// INTERNAL PROJECT REPOSITORY
// ============================================================================

model InternalProject {
  id          String @id @default(cuid())
  name        String
  note        String? // optional free-text note (was "description")
  serviceType String // "Automation" | "Web Development" | "Brand & Graphic Design"

  googleDriveLink String

  uploadedBy String
  uploader   AdminUser @relation(fields: [uploadedBy], references: [id])

  status     String @default("active") // "active" | "archived" | "completed"
  visibility String @default("team") // "team" (all admins) — no per-admin privacy in v1

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceType])
  @@index([uploadedBy])
  @@index([status])
}
