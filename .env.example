# Backend API base URL. REQUIRED - the contact form posts here, and the site
# reads projects/services/reviews/team from it (falling back to the bundled
# static copy in src/data/ if the API is unreachable).
#   local:      http://localhost:3001
#   production: your backend's Vercel URL, e.g. https://nexoryn-zimw-nexoryn.vercel.app
#
# Note: whatever origin you set here must also appear in the `connect-src`
# directive of the Content-Security-Policy in vercel.json, or the browser will
# block every request to it.
VITE_API_BASE_URL=

# EmailJS (VITE_EMAILJS_SERVICE_ID / _TEMPLATE_ID / _PUBLIC_KEY) has been
# removed. It required all three values to sit in the client bundle, where
# anyone can read them - which let those credentials be used to send mail
# through the account directly, bypassing this site's rate limiting, honeypot
# and server-side validation entirely. The contact form now posts to the
# backend, which sends via Resend server-side and stores the submission either
# way. If those keys were ever deployed, rotate them in the EmailJS dashboard:
# they are already public.
