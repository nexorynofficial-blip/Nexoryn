# EmailJS credentials for the contact form (src/lib/sendContactEmail.js).
# Create a free account at https://www.emailjs.com, add nexorynofficial@gmail.com
# as an email service, and create one template using these variables:
#   {{to_email}} {{subject}} {{from_name}} {{reply_to}} {{message}}
# Then copy your IDs below into a real .env file (never commit that file).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Backend API base URL. Leave EMPTY to run the site entirely on the bundled
# static content in src/data/ (exactly how it behaved before the backend
# existed). Set it and the site reads projects/services/reviews/team from the
# API instead, falls back to the static copy if the API is unreachable, and
# posts the contact form to the backend so submissions land in the admin
# Contact Inbox.
#   local:      http://localhost:3001
#   production: https://api.nexoryn.ai   (your deployed backend)
VITE_API_BASE_URL=
