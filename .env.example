# EmailJS credentials for the contact form (src/lib/sendContactEmail.js).
# Create a free account at https://www.emailjs.com, add nexorynofficial@gmail.com
# as an email service, and create one template using these variables:
#   {{to_email}} {{subject}} {{from_name}} {{reply_to}} {{message}}
# Then copy your IDs below into a real .env file (never commit that file).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
